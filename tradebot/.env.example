# Copy to .env and fill in. Never commit .env.
# No exchange API keys belong here: the bots are dry-run (paper) only, and Revolut X candles
# are fetched from its public endpoint without a key.

# Telegram reporter (cockpit + evaluate.py)
TELEGRAM_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=your-chat-id

# Local API for FreqUI and the cockpit (only reachable from this PC)
FREQTRADE__API_SERVER__PASSWORD=choose-a-local-password
FREQTRADE__API_SERVER__JWT_SECRET_KEY=at-least-32-random-characters-here
FREQTRADE__API_SERVER__WS_TOKEN=another-random-string

# Shared secret between the bots' webhooks and the cockpit
HOOK_TOKEN=a-random-string
